{
  "name": "pnpm-deny",
  "version": "0.1.0",
  "description": "Pnpm plugin for linting your dependencies",
  "type": "module",
  "bin": {
    "deny": "./bin/deny.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pnpm-deny/core": "workspace:*",
    "@pnpm-deny/licenses": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
